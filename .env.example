OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required contingency model: used when OPENROUTER_MODEL fails after retries
# (same API key and base URL). Example: openai/gpt-4o-mini
OPENROUTER_MODEL_FALLBACK=
OPENROUTER_BASE_URL=https:openrouter.ai/api/vi

# Per-section context budgets (estimated tokens = floor(chars/4))
CONTEXT_BUDGET_SUMMARY=200
CONTEXT_BUDGET_WINDOW=1200
CONTEXT_BUDGET_MEMORIES=300

# GET /stats cost: USD per 1M prompt tokens by model id. ":free" models cost 0;
# models missing here are reported as unpricedRequests. Example:
# OPSPILOT_MODEL_PRICES={"openai/gpt-4o-mini":0.15}
OPSPILOT_MODEL_PRICES=

# Browser origins allowed to call the API (war room). Comma-separated exact
# origins, never '*'. Empty = local war room dev/preview (localhost:5173/4173).
# Example: OPSPILOT_CORS_ORIGINS=https://ops.example.com
OPSPILOT_CORS_ORIGINS=

# Minutes a pending human approval (resolve_incident / forget_preference) stays valid.
OPSPILOT_APPROVAL_TTL_MINUTES=1440
