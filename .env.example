OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required contingency model: used when OPENROUTER_MODEL fails after retries
# (same API key and base URL). Example: openai/gpt-4o-mini
OPENROUTER_MODEL_FALLBACK=
OPENROUTER_BASE_URL=https:openrouter.ai/api/vi

# Per-section context budgets (estimated tokens = floor(chars/4))
CONTEXT_BUDGET_SUMMARY=200
CONTEXT_BUDGET_WINDOW=1200
CONTEXT_BUDGET_MEMORIES=300
